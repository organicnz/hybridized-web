NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5lc2x4Y2hkdGliemh4aWp4Y2JnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDU4ODQ2NTQsImV4cCI6MjA2MTQ2MDY1NH0.iWl6MlQeDW4oTfrqV85WnRdIav8eRgQUPKG9fb2jnUw
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Site URL for auth redirects (change in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry error/performance monitoring (optional). The DSN is a public client key,
# safe to expose to the browser. Leave blank to disable Sentry.
NEXT_PUBLIC_SENTRY_DSN=

# Edge Functions Authorization
# Generate with: openssl rand -base64 32
FUNCTION_SECRET=your-function-secret-here

# Web API sync endpoints (/api/v1/sync-*, /api/v1/match-*) as an alternative to an admin profile.
# These write to RLS-protected tables, so the server must also have SUPABASE_SECRET_KEY set
# (the service client is used for the writes; without it an unauthenticated call is denied by RLS).
SYNC_SECRET=your-sync-secret-here
