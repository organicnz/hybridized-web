{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "trailingCommas": "onlyMultiLine",
    "proseWrap": "never"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
