{
  "name": "hybridized-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.3-canary.20261019.1",
  "scripts": {
    "dev": "bun run --bun next dev",
    "build": "bun run --bun next build",
    "start": "bun run --bun next start",
    "lint": "bun lint --no-script -c oxlint.json",
    "format": "bun fmt",
    "fix": "bun lint --no-script -c oxlint.json --fix && bun fmt",
    "typecheck": "bun x --bun tsrs --noEmit",
    "typecheck:fast": "bun check",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "verify": "bun run lint && bun run typecheck && bun run typecheck:fast && bun test",
    "doctor": "bun scripts/doctor.ts",
    "setup:bun": "bun scripts/install-bun.ts",
    "setup:tsdk": "bun scripts/setup-tsdk.ts",
    "shader:check": "vgpu check shaders/*.wgsl --require-validation",
    "shader:doctor": "vgpu doctor",
    "types:supabase": "supabase gen types typescript --project-id neslxchdtibzhxijxcbg > lib/types/database.types.ts",
    "prepare": "bun scripts/lefthook/prepare.ts",
    "lefthook:install": "bun scripts/lefthook/install.ts",
    "lefthook:uninstall": "bun scripts/lefthook/uninstall.ts",
    "lefthook:run": "bun scripts/lefthook/run.ts",
    "deploy:functions": "bun scripts/deploy-functions.ts",
    "playlists:count": "bun scripts/count-playlist-episodes.ts",
    "audit": "bun audit",
    "outdated": "bun outdated"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.6.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "hono": "^4.13.13",
    "lucide-react": "^0.454.0",
    "next": "16.5.0-canary.19",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-h5-audio-player": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "vgpu": "^0.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "26.6.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@webgpu/types": "^0.1.74",
    "bun-types": "1.4.4-canary.20261019T141446",
    "lefthook": "^2.0.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^4",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tw-animate-css": "1.4.0"
  },
  "overrides": {
    "next-intl": {
      "next": "^16.0.0"
    }
  },
  "trustedDependencies": [
    "@vgpu/adapter-node",
    "lefthook",
    "sharp",
    "webgpu"
  ],
  "engines": {
    "bun": ">=1.4.0"
  }
}
