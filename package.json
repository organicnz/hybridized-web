{
  "name": "hybridized-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "bun run lint:ox && bun run lint:biome",
    "lint:ox": "oxlint --config oxlint.json .",
    "lint:biome": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "shader:check": "vgpu check shaders/*.wgsl --require-validation",
    "shader:doctor": "vgpu doctor",
    "types:supabase": "supabase gen types typescript --project-id neslxchdtibzhxijxcbg > lib/types/database.types.ts",
    "prepare": "[ \"$CI\" = \"1\" ] || [ -n \"$VERCEL\" ] || lefthook install",
    "lefthook:install": "bash scripts/lefthook/install.sh",
    "lefthook:uninstall": "bash scripts/lefthook/uninstall.sh",
    "lefthook:run": "bash scripts/lefthook/run.sh"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.6.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@types/xml2js": "^0.4.14",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "hono": "^4.13.13",
    "lucide-react": "^0.454.0",
    "next": "16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-h5-audio-player": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "vgpu": "^0.5.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@webgpu/types": "^0.1.74",
    "autoprefixer": "^10.4.20",
    "bun-types": "^1.4.2",
    "lefthook": "^2.0.4",
    "oxlint": "^0.16.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "next-intl": {
      "next": "^16.0.0"
    }
  },
  "trustedDependencies": ["@biomejs/biome", "lefthook"]
}
