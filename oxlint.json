{
  // The plugins the rules come from.
  //
  // This list replaces the defaults rather than adding to them, so a rule
  // from a plugin that is not named here never runs — and it fails silently.
  // `typescript` and `eslint` are named for that reason: the rules below are
  // theirs, and without them the file reads as if they were enforced.
  "plugins": ["eslint", "jsx-a11y", "nextjs", "react", "react-hooks", "typescript", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-console": "off",
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "unicorn/prefer-module": "off",
    "unicorn/no-process-exit": "off",
    "react/set-state-in-effect": "warn",
    "react/refs": "warn",
    "react/purity": "warn",
    "react/immutability": "warn",

    "typescript/no-explicit-any": "error",
    "eqeqeq": "error",
    "typescript/ban-ts-comment": "error",

    // A promise nobody awaits runs on its own, and if it rejects the error
    // lands in the console with nobody able to act on it. The rule needs the
    // type information, so it is the one that complements `tsrs`: the type
    // checker proves the promise is a promise, and this rule proves somebody
    // is looking after it.
    //
    // `mock.module` is exempt because Bun's own types say it returns
    // `void | Promise<void>`, and the rule cannot tell which. The test
    // framework handles it either way.
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": ["module"]
      }
    ],

    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-ambiguous-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/control-has-associated-label": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    // Music has no spoken dialogue, so the players' <audio> elements have no
    // caption track to attach. Biome's `useMediaCaption` did not flag them
    // either; this keeps the two linters in agreement.
    "jsx-a11y/media-has-caption": "off",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/prefer-tag-over-role": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error"
  },
  "ignorePatterns": [
    "node_modules",
    ".next",
    "dist",
    // Generated by the Supabase CLI from the live database. The rules about
    // the shape of a type do not apply to code nobody writes by hand.
    "lib/types/database.types.ts"
  ]
}
